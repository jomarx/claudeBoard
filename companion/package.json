{
  "name": "claudeboard-companion",
  "version": "0.2.0",
  "description": "Reads Claude Code usage on this PC and pushes it to the claudeBoard meter over USB serial",
  "main": "companion.js",
  "bin": "companion.js",
  "scripts": {
    "start": "node companion.js",
    "dry": "node companion.js --dry-run --once",
    "build:exe": "pkg . --output dist/claudeBoard.exe && node tools/gui-subsystem.js dist/claudeBoard.exe"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.26.0"
  },
  "pkg": {
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist",
    "assets": [
      "public/**/*",
      "node_modules/@serialport/bindings-cpp/prebuilds/win32-x64/**/*"
    ]
  }
}
